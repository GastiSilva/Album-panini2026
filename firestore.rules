rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Cualquier usuario autenticado puede LEER perfiles (para comparar intercambios)
      allow read: if request.auth != null;

      // Solo el propio usuario puede CREAR o ACTUALIZAR su documento
      allow create: if request.auth.uid == userId
        && request.resource.data.keys().hasAll(['displayName', 'createdAt'])
        && request.resource.data.owned == null || request.resource.data.owned is map;

      allow update: if request.auth.uid == userId
        && request.resource.data.owned is map
        && request.resource.data.owned.size() <= 980;

      allow delete: if false; // No permitir borrar cuentas desde el cliente
    }

    // ── Propuestas de intercambio ──────────────────────────────────────────
    match /exchanges/{exchangeId} {
      // Solo las partes involucradas pueden leer
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
         || resource.data.toUid   == request.auth.uid);

      // Solo el remitente puede crear (y debe poner su propio uid en fromUid)
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;

      // Ambas partes pueden actualizar (remitente cancela, receptor acepta/rechaza)
      allow update: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
         || resource.data.toUid   == request.auth.uid);

      allow delete: if false;
    }
  }
}
