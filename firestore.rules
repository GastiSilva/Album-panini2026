rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      // 'write' engloba create, update y delete. Sin validaciones raras que te traben.
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Propuestas de intercambio ──────────────────────────────────────────
    match /exchanges/{exchangeId} {
      // Solo las partes involucradas pueden leer
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
         || resource.data.toUid   == request.auth.uid);

      // Solo el remitente puede crear (y debe poner su propio uid en fromUid)
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;

      // Ambas partes pueden actualizar (remitente cancela, receptor acepta/rechaza)
      allow update: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
         || resource.data.toUid   == request.auth.uid);

      allow delete: if false;
    }
  }
}
